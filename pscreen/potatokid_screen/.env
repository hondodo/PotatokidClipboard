BASE_URL=https://api.example.com
IS_DEBUG=true
ENABLE_PROXY=false
ENABLE_DEV_TOOLS=true

# 心知天气（免费版走 V3，用私钥 key 鉴权）
SENIVERSE_V3_KEY=SgFcWWIRoL5AnKQvO
SENIVERSE_WEATHER_HOST_V3=https://api.seniverse.com/v3
# IP 反查城市不受免费版覆盖（AP010006）时，回退到默认城市名
SENIVERSE_DEFAULT_LOCATION=湛江
# V4（公钥签名）需购买 V4 数据产品后才有权限，当前免费版不开放
SENIVERSE_PUBLIC_KEY=PUD5Dk9PlH60TELMz
SENIVERSE_SECRET_KEY=SgFcWWIRoL5AnKQvO
SENIVERSE_WEATHER_HOST=https://api.seniverse.com/v4
# IP 反查定位（首个优先，失败切备用）
SENIVERSE_IP_GEO_HOST=https://ipwho.is/
SENIVERSE_IP_GEO_HOST_B=https://ipapi.co/json/

# 「我的」页「天气城市」可选列表（英文逗号分隔，顺序即左/右步进顺序）。
# 「自动」（IP 反查定位）为隐式首项，不要写在这里。留空则只提供「自动」。
WEATHER_CITIES=湛江,广州,佛山

